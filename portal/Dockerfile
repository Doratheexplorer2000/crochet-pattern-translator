FROM node:24-alpine AS build

WORKDIR /app

ARG PUBLIC_PATTERN_TRANSLATOR_URL=http://localhost:8501
ARG PUBLIC_STITCH_TRANSLATOR_URL=https://stitch-translator-production.up.railway.app/
ARG PUBLIC_SHOW_FUTURE_TOOLS=false
ARG PUBLIC_SHOW_AD_BAR=false
ARG PUBLIC_PLAUSIBLE_SCRIPT_URL=
ENV PUBLIC_PATTERN_TRANSLATOR_URL=${PUBLIC_PATTERN_TRANSLATOR_URL}
ENV PUBLIC_STITCH_TRANSLATOR_URL=${PUBLIC_STITCH_TRANSLATOR_URL}
ENV PUBLIC_SHOW_FUTURE_TOOLS=${PUBLIC_SHOW_FUTURE_TOOLS}
ENV PUBLIC_SHOW_AD_BAR=${PUBLIC_SHOW_AD_BAR}
ENV PUBLIC_PLAUSIBLE_SCRIPT_URL=${PUBLIC_PLAUSIBLE_SCRIPT_URL}
ENV ASTRO_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

ENV PORT=8080
ENV NGINX_ENVSUBST_FILTER=PORT

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
