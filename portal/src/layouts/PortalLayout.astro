---
import { translations } from "../i18n/translations";
import "../styles/global.css";

type Props = {
  title: string;
};

const { title } = Astro.props;
const plausibleScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL?.trim() || "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Crochet Intelligence platform portal" />
    <title data-i18n="meta.title">{title}</title>
    {plausibleScriptUrl && <script is:inline async src={plausibleScriptUrl}></script>}
    {plausibleScriptUrl && (
      <script is:inline>
        window.plausible = window.plausible || ((...args) => {
          (window.plausible.q = window.plausible.q || []).push(args);
        });
        window.plausible.init = window.plausible.init || ((options) => {
          window.plausible.o = options || {};
        });
        window.plausible.init();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script is:inline define:vars={{ translations }}>
      const supportedLocales = ["en", "zh-Hant", "zh-Hans", "ja"];
      const defaultLocale = "en";
      const languageEvents = {
        en: "language_en",
        "zh-Hant": "language_zh_hant",
        "zh-Hans": "language_zh_hans",
        ja: "language_ja",
      };
      let lastTrackedLanguageChange = "";

      function browserLocale() {
        const language = navigator.language.toLowerCase();
        if (language.startsWith("ja")) return "ja";
        if (language.startsWith("zh-tw") || language.startsWith("zh-hk") || language.startsWith("zh-mo")) {
          return "zh-Hant";
        }
        if (language.startsWith("zh")) return "zh-Hans";
        return defaultLocale;
      }

      function storedLocale() {
        try {
          const value = window.localStorage.getItem("ci_portal_language");
          return supportedLocales.includes(value) ? value : null;
        } catch {
          return null;
        }
      }

      function queryLocale() {
        const value = new URLSearchParams(window.location.search).get("ui_lang");
        return supportedLocales.includes(value) ? value : null;
      }

      function updateToolLinks(locale) {
        document.querySelectorAll("a[data-tool-href]").forEach((element) => {
          const configuredHref = element.getAttribute("data-tool-href");
          if (!configuredHref) return;

          try {
            const toolUrl = new URL(configuredHref, window.location.href);
            toolUrl.searchParams.set("ui_lang", locale);
            element.setAttribute("href", toolUrl.toString());
          } catch {
            // A malformed configured tool URL must not break Portal rendering.
          }
        });
      }

      function applyLocale(locale) {
        const selectedLocale = supportedLocales.includes(locale) ? locale : defaultLocale;
        const messages = translations[selectedLocale];
        document.documentElement.lang = selectedLocale;

        document.querySelectorAll("[data-i18n]").forEach((element) => {
          const key = element.getAttribute("data-i18n");
          if (key && messages[key]) element.textContent = messages[key];
        });

        document.querySelectorAll("[data-i18n-aria-label]").forEach((element) => {
          const key = element.getAttribute("data-i18n-aria-label");
          if (key && messages[key]) element.setAttribute("aria-label", messages[key]);
        });

        const selector = document.querySelector("#language-selector");
        if (selector) selector.value = selectedLocale;
        updateToolLinks(selectedLocale);

        try {
          window.localStorage.setItem("ci_portal_language", selectedLocale);
        } catch {
          // The selected language still applies for this page when storage is unavailable.
        }
      }

      function trackLanguageChange(locale) {
        const eventName = languageEvents[locale];
        if (!eventName || eventName === lastTrackedLanguageChange) return;
        lastTrackedLanguageChange = eventName;

        try {
          if (typeof window.plausible === "function") {
            window.plausible(eventName);
          }
        } catch {
          // Analytics must never affect rendering, language selection, or navigation.
        }
      }

      const languageSelector = document.querySelector("#language-selector");
      languageSelector?.addEventListener("change", (event) => {
        const selectedLocale = event.target.value;
        applyLocale(selectedLocale);
        trackLanguageChange(selectedLocale);
      });

      applyLocale(queryLocale() || storedLocale() || browserLocale());
    </script>
  </body>
</html>
