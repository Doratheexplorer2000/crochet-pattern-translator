<header class="site-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label="Crochet Intelligence home">
      <span class="logo-placeholder" aria-hidden="true">CI</span>
      <span data-i18n="header.platformName">Crochet Intelligence</span>
    </a>
    <div class="header-controls">
      <label class="language-control" for="language-selector">
        <span data-i18n="header.languageLabel">Interface language</span>
        <select id="language-selector" name="language">
          <option value="en">English</option>
          <option value="zh-Hant">繁體中文</option>
          <option value="zh-Hans">简体中文</option>
          <option value="ja">日本語</option>
        </select>
      </label>
    </div>
  </div>
</header>
